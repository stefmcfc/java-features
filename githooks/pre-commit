#!/bin/sh
# Red-Green TDD gate: block commits unless the full test suite passes.
# Installed via `git config core.hooksPath githooks` (see RUNBOOK.md).

echo "Running test suite before commit..."

./gradlew test

status=$?

if [ $status -ne 0 ]; then
  echo ""
  echo "Commit blocked: tests are failing. Fix them (or finish the Red step"
  echo "of TDD) before committing."
  exit $status
fi

exit 0
